# Neon PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth.js
AUTH_SECRET=genera-con-openssl-rand-base64-32
AUTH_TRUST_HOST=true

# Tenable (solo servidor — nunca NEXT_PUBLIC_*)
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=
USE_MOCK_TENABLE=false
TENABLE_SYNC_MODE=phased
TENABLE_PHASE_SEVERITIES=critical
TENABLE_SYNC_FIXED=true
TENABLE_VULN_NUM_ASSETS=500
TENABLE_VULN_SINCE_DAYS=365
TENABLE_EXPORT_TIMEOUT_MS=1200000
